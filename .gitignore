# ---------- Python / Backend ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Modelos entrenados (se distribuyen por Object Storage, no por Git)
backend/models/*.joblib
backend/models/*.pkl
backend/models/*.pickle

# Respaldo automatico de scripts/enriquecer_mapeo_cursos.py (no se versiona)
Data/*.json.bak

# ---------- Node / Frontend ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ---------- Entorno ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Editores / SO ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel
.env*

# Las plantillas SI se versionan. Esta excepcion va al final a proposito:
# git aplica "la ultima regla que coincide gana", asi que un `!.env.example`
# colocado antes de `.env*` no tendria efecto y los `.env.example` nuevos
# quedarian ignorados en silencio (solo sobrevive `frontend/.env.example`
# porque ya estaba versionado antes de anadirse la regla).
!.env.example
!**/.env.example

# ---------- Base de usuarios local (Semana 5) ----------
# SQLite de desarrollo (fallback cuando ATHENIA_DB_URL no esta definido).
# Nunca debe versionarse: contiene hashes de contrasenas reales del equipo.
backend/data/*.db
backend/data/*.sqlite3
