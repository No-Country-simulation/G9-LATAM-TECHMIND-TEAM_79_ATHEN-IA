# =============================================================================
# AthenIA - Variables de entorno del backend
#
# Copiar a `.env` y ajustar. Ningun valor de aqui es secreto: son parametros de
# despliegue. Los secretos reales (credenciales de Oracle DB, claves de OCI) se
# inyectan por el gestor de secretos del entorno, NUNCA en un archivo del repo.
#
# Todas tienen un valor por defecto seguro en `app/config.py`: la API arranca
# sin definir ninguna.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
# development | production. En production, `uvicorn` no recarga al cambiar codigo.
ATHENIA_ENV=development

# DEBUG | INFO | WARNING | ERROR
ATHENIA_LOG_LEVEL=INFO

# --- Servidor ----------------------------------------------------------------
# 127.0.0.1 en local. En contenedor DEBE ser 0.0.0.0 o el puerto no se publica.
ATHENIA_HOST=127.0.0.1
ATHENIA_PORT=8000

# --- CORS --------------------------------------------------------------------
# Origenes permitidos, separados por coma. "*" solo es aceptable en desarrollo.
#
# Si el frontend se sirve tras Nginx con proxy de /api (ver docker-compose.yml),
# el navegador nunca hace peticiones cross-origin y esto es casi irrelevante.
# Si el backend se expone en su propio dominio, enumerar los origenes reales:
#   ATHENIA_CORS_ORIGINS=https://athenia.example.com,https://www.athenia.example.com
ATHENIA_CORS_ORIGINS=*

# --- Modelo de IA ------------------------------------------------------------
# Carpeta donde Data Science deja el artefacto entrenado.
# ATHENIA_MODELOS_DIR=/app/models

# Ruta explicita al .pkl/.joblib. Si se omite, se autodetecta por nombre dentro
# de ATHENIA_MODELOS_DIR (primero `clasificador_cursos.pkl`).
# ATHENIA_MODELO_PATH=/app/models/clasificador_cursos.pkl

# --- Historial en memoria ----------------------------------------------------
# Precarga 8 contenidos de ejemplo al arrancar, para que el Dashboard no
# aparezca vacio en la demo. "false" para arrancar limpio.
ATHENIA_SEED_DEMO=true

# Tope de analisis guardados en memoria (se descartan los mas antiguos).
ATHENIA_MAX_HISTORIAL=500

# --- Base de usuarios (Semana 5) ----------------------------------------------
# Sin definir, cae a un archivo SQLite en backend/data/ (cero setup local).
# En docker-compose.yml se apunta al servicio "athenia-db" (Postgres):
# ATHENIA_DB_URL=postgresql+psycopg2://athenia:CAMBIAR_ESTA_CLAVE@athenia-db:5432/athenia
# ATHENIA_DB_URL=

# --- Sesiones (JWT) -------------------------------------------------------------
# OBLIGATORIO cambiar en produccion. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ATHENIA_JWT_SECRET=
# Vigencia del token de sesion, en minutos. Por defecto 1440 (24 horas).
# ATHENIA_JWT_EXPIRA_MIN=1440

# --- Reservado (Object Storage / OCI) ------------------------------------------
# ATHENIA_OCI_BUCKET=
# ATHENIA_OCI_NAMESPACE=
# ATHENIA_OCI_REGION=
